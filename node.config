{
  "schemaVersion": "2.0",
  "name": "StayFinder",
  "slug": "stayfinder",
  "type": "fastapi-react-app",
  "visibility": "public",
  "hostBase": "stayfinder.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": {
    "id": "stayFinder",
    "cluster": [
      "Travel"
    ],
    "displayName": "StayFinder",
    "commercial": false
  },
  "brain_profile": "standard",
  "tooling": {
    "grants": [
      { "kind": "mcp-toolset", "ref": "graph,brain", "scope": "self" },
      { "kind": "mcp-toolset", "ref": "db,brain", "scope": "subtree" }
    ],
    "deny": [],
    "subagents": {
      "api-reviewer": { "toolsets": ["db"], "readOnly": true },
      "ui-reviewer": { "toolsets": ["brain"], "readOnly": true }
    }
  },
  "capabilities": ["build", "test", "deploy"],
  "agents": {
    "archetypes": []
  },
  "mcp": {
    "toolsets": ["graph", "brain", "db"],
    "readOnly": true
  },
  "deploy": {
    "appModule": "stayfinder_backend.app:app",
    "healthPath": "/health",
    "migrations": true,
    "database": {
      "name": "stayfinder",
      "user": "stayfinder",
      "host": "stayfinder-db",
      "driver": "postgresql+asyncpg"
    }
  },
  "children": [],
  "famiglia": "finder",
  "vista": {
    "sezioni": [
      { "id": "cerca", "titolo": "Cerca", "min": "player" },
      { "id": "risultati", "titolo": "Risultati", "min": "player" },
      { "id": "salvati", "titolo": "Salvati", "min": "player" },
      { "id": "impostazioni", "titolo": "Impostazioni", "min": "admin" }
    ],
    "azioni": { "ricerca.crea": "creator", "ricerca.elimina": "admin", "salvato.crea": "creator", "salvato.modifica": "creator", "salvato.elimina": "creator", "impostazioni.modifica": "admin" }
  }
}
